[Unit]
Description=Is There Football web UI
After=network.target

[Service]
Type=simple
User=barnusian
WorkingDirectory=/home/barnusian/istherefootball
ExecStart=/home/barnusian/istherefootball/.venv/bin/python /home/barnusian/istherefootball/scripts/web_server.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
